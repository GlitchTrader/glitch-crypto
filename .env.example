GLITCH_LOCAL_HOST=127.0.0.1
GLITCH_LOCAL_PORT=8791
GLITCH_LOCAL_TOKEN=replace-with-a-long-random-model-token
GLITCH_OPERATOR_TOKEN=replace-with-a-different-long-random-operator-token
GLITCH_DATA_DIR=./data
GLITCH_GATEWAY_MODE=shadow
GLITCH_RUNTIME_MODE=binance-shadow
GLITCH_PAPER_INITIAL_EQUITY_USD=1000
GLITCH_PAPER_INITIAL_BTC_PRICE_USD=60000

# Live Binance market evidence with paper/shadow execution.
GLITCH_BINANCE_USDM_BASE_URL=https://fapi.binance.com
GLITCH_BINANCE_USDM_STREAMS_URL=wss://fstream.binance.com
GLITCH_BINANCE_USDM_SYMBOL=BTCUSDT
GLITCH_BINANCE_USDM_API_KEY=
GLITCH_BINANCE_USDM_API_SECRET=
GLITCH_BINANCE_INCLUDE_PRIVATE=false
GLITCH_BINANCE_USDM_RECV_WINDOW_MS=5000
GLITCH_BINANCE_USDM_TIMEOUT_MS=10000
GLITCH_BINANCE_USDM_EVIDENCE_PATH=./data/binance-usdm-shadow.jsonl
GLITCH_BINANCE_USDM_EVIDENCE_MAX_BYTES=33554432

# Transparent uncalibrated opportunity baseline. Values are basis points unless noted.
GLITCH_SHADOW_EVALUATION_INTERVAL_MS=250
GLITCH_SHADOW_CANDIDATE_COOLDOWN_MS=30000
GLITCH_SHADOW_POSITION_REVIEW_MS=5000
GLITCH_SHADOW_EVENT_LIFETIME_MS=180000
GLITCH_SHADOW_MINIMUM_TRADES=20
GLITCH_SHADOW_MINIMUM_DIRECTIONAL_BPS=4
GLITCH_SHADOW_MINIMUM_GROSS_MOVE_BPS=10
GLITCH_SHADOW_MINIMUM_EDGE_BPS=1.5
GLITCH_SHADOW_ESTIMATED_ROUND_TRIP_COST_BPS=10
GLITCH_SHADOW_MAXIMUM_MARKET_AGE_MS=3000
